{
  "expo": {
    "name": "Sunprime Admin",
    "slug": "sunprime-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sunprimeadmin",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a2b"
    },
    "android": {
      "package": "com.ant0ney.sunprimepos",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e3a2b"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "bde2c1ae-fd0d-40ff-b800-dc1e89aff814"
      }
    }
  }
}
