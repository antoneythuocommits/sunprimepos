{
  "expo": {
    "name": "Sunprime Admin",
    "slug": "sunprime-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sunprimeadmin",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "platforms": ["ios", "android"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a2b"
    },
    "android": {
      "package": "com.ant0ney.sunprimepos",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e3a2b"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "bde2c1ae-fd0d-40ff-b800-dc1e89aff814"
      }
    }
  }
}
